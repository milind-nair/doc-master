// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Document {
  id      String    @id @default(uuid())
  title   String
  content String
  comments Comment[]
}

model User {
  id       String    @id @default(uuid())
  username String    @unique // simple handle like 'alice'
  name     String
  mentions Mention[]
  comments Comment[]
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  quote     String?   // The selected text context
  rangeStart Int?     // Start index of selection
  rangeEnd   Int?     // End index of selection
  status    String    @default("open") // open, resolved, deleted
  docId     String
  document  Document  @relation(fields: [docId], references: [id])
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    Comment?  @relation("Thread", fields: [parentId], references: [id])
  children  Comment[] @relation("Thread")
  mentions  Mention[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Mention {
  id        String  @id @default(uuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  read      Boolean @default(false)
}
